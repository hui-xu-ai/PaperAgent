# =============================================================================
#  PaperAgent 配置模板（v1.3.0）
# -----------------------------------------------------------------------------
#  怎么用：把本文件复制一份改名 .env，放到 PaperAgent.exe 同级目录，然后**只填密钥**：
#      MINERU_API_KEY       解析 PDF（必填。没有它，导入后无法解析）
#      DEEPSEEK_API_KEY     大模型主用：翻译 / 编译 / 问答（必填）
#      ZHIPU_API_KEY        智谱 GLM（可选，第二家大模型）
#      SILICONFLOW_API_KEY  硅基流动（可选但推荐：翻译模型 + 向量检索共用这一个 Key）
#  其他键都已填好合适默认值，**不用改**。想改建议去界面「设置」里点，程序会自动写回本文件。
#  **优先级（重要）**：本文件的值为准 —— 程序启动时用本文件**覆盖**系统环境变量（含空值：
#  在这里把某行清空 = 该配置失效）。所以只改这一个文件就够了，不要去设 Windows 环境变量，
#  否则"我改了却不生效"（系统变量会被本文件压住，启动日志里会提示哪些键被覆盖）。
#  注意：本文件不含任何真实密钥，不要提交到公开仓库。
# =============================================================================


# ============================== 1. 大语言模型 ================================
# 默认两家：DeepSeek（主）+ 智谱 GLM（备）。哪家用哪个在界面「设置 → 🤖 模型」里点「激活」。
# -- ① DeepSeek 官方（主模型）--
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
# 单次输出上限（翻译一次最多生成多少 token；留空用程序默认 64000）
DEEPSEEK_MAX_TOKENS=64000

# -- ② 智谱 GLM（第二家；填了 Key 就自动出现在模型列表）--
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash
ZHIPU_MAX_TOKENS=64000

# -- ③ 调用行为（一般不用改）--
# 单次调用超时（秒）与重试次数：翻译/编译一篇长文可能跑几分钟，超时给宽一点
LLM_TIMEOUT_SEC=600
LLM_MAX_RETRIES=1


# ========================= 2. 翻译模型（可选，推荐开）=========================
# 目的：把"翻译"从主模型上分出来，用更便宜的模型专门翻，省钱也更快。
# 默认用硅基流动的 Qwen2.5-7B-Instruct（免费额度友好，8K 输出）。
# 填法：只填下面的 API_KEY 即可；**留空则自动复用 SILICONFLOW_API_KEY**（同一个硅基 Key 通用）。
# ENABLED=1 表示激活该模型（界面里可存多个备选，但**同时只有一个生效**，单选激活；
# 全部为 0 = 翻译回落主模型）。
TRANSLATE_0_BASE_URL=https://api.siliconflow.cn/v1
TRANSLATE_0_MODEL=Qwen/Qwen2.5-7B-Instruct
# 输出预算（max_tokens）：一般不用改。程序会按「翻译批次上限」自动推导
# （预算 = max(这里的值, 批次上限 × 0.4)，只增不减），批次上限在界面「设置 → 知识库」改。
TRANSLATE_0_MAX_TOKENS=8192
TRANSLATE_0_ENABLED=1
TRANSLATE_0_API_KEY=


# ===================== 3. PDF 解析：MinerU（主通道，必填）=====================
# 申请地址：https://mineru.net/apiManage （可免费申请）。**没有 Key 会直接拒绝解析。**
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
# 解析模型：vlm（推荐，视觉语言模型，识别质量最好）| pipeline（传统管线）
MINERU_MODEL_VERSION=vlm
# 解析语言：auto（按首页字符集自动判中/英）| en | ch
MINERU_LANGUAGE=auto
# 扫描件 OCR：on（强制开启，扫描版 PDF 必开）| auto（无文本层才开）| off
MINERU_IS_OCR=on
# 表格 / 公式识别（1=开，0=关）
MINERU_ENABLE_TABLE=1
MINERU_ENABLE_FORMULA=1
# 解析通道：auto（默认，双通道＋AI 仲裁）| mineru-v4 | pymupdf（本地）
MINERU_PARSER=auto
# 接口路径（一般不用改；MinerU 升级换路径时才动，界面「设置 → 📄 解析」里也可改）
MINERU_UPLOAD_PATH=/file-urls/batch
MINERU_SUBMIT_PATH=/extract/task
MINERU_POLL_PATH=/extract/task/{task_id}
MINERU_BATCH_RESULTS_PATH=/extract-results/batch/{batch_id}


# ============ 4. PDF 解析辅通道：PaddleOCR-VL（参与逐段字符仲裁）=============
# 与 MinerU 各识别一遍，逐段比对取更优的那个（"双通道"）。没有 Token 时自动只用主通道。
# 申请：AI Studio（https://aistudio.baidu.com ）→ 访问令牌
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com
PADDLEOCR_MODEL_VERSION=PaddleOCR-VL-1.6
# 辅通道增强：跨页表格 + 标题重整 / 合并表格 / 标题分级
PADDLEOCR_OPTIONS={"restructurePages": true, "mergeTables": true, "relevelTitles": true}


# ================= 5. 向量检索（AI检索 / 知识库问答的语义通道）=================
# 同一个硅基流动 Key 通用：上面填了 SILICONFLOW_API_KEY，这里两个 Key 留空即可。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
LIT_EMBEDDING_MODEL=BAAI/bge-m3
LIT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 想单独指定别的 Key 时才填（留空 = 用 SILICONFLOW_API_KEY）
LIT_EMBEDDING_API_KEY=
LIT_RERANKER_API_KEY=


# ============================== 6. 服务与日志 ================================
PAPERAGENT_HOST=127.0.0.1
PAPERAGENT_PORT=8900
# 日志级别（落盘 logs/paperagent.log，10MB×3 轮转）：DEBUG | INFO | WARNING
PAPERAGENT_LOG_LEVEL=INFO
# 优雅关停宽限窗（秒）：关停时等在跑任务收尾的上限，超时才硬退
PAPERAGENT_GRACE_SECONDS=30


# ============================== 7. 会话与缓存 ================================
CHAT_HISTORY_LIMIT=12
ANSWER_CACHE_SIZE=256
QUERY_LIMIT_CHARS=1500


# ============================== 8. 数据位置 ==================================
# ⚠️ 路径类键默认就指向正确位置（打包版 = exe 同目录；开发 = 项目根）——**不要在这里再写一遍**：
#    同一个事实有两个来源时，实测会让数据写进错误的库（见 docs/DATA-LAYOUT.md §4）。
#    确需覆盖才填，并在 docs/COMPAT-REGISTER.md 登记。
# PAPERAGENT_DB / ENGINE_WORK_ROOT / ENGINE_OUT_ROOT / ENGINE_INPUT_ROOT
