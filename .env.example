# ===== DeepSeek LLM =====
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=600
LLM_MAX_RETRIES=1

# ===== 备用/第二供应商（可选；设置页也可配，缺失则该供应商不出现在模型列表）=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=

# ===== paper-reader 引擎 =====
# MinerU 精准解析密钥（缺失时 auto 自动降级为 v1 免费通道 / 本地 pymupdf）
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
# 解析通道：auto | mineru-v4（精准，需 Key） | mineru（v1 免费，限流） | pymupdf（本地）
MINERU_PARSER=auto

# ===== OCR（可选；PaddleOCR 服务端 token，缺失则本地 PyMuPDF 兜底）=====
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_BASE_URL=
PADDLEOCR_MODEL_VERSION=

# ===== Web 服务 =====
PAPERAGENT_HOST=127.0.0.1
PAPERAGENT_PORT=8900
# 日志级别（落盘 logs/paperagent.log，10MB×3 轮转）：DEBUG | INFO | WARNING
PAPERAGENT_LOG_LEVEL=INFO
# 优雅关停宽限窗（秒）：关停时等在跑任务收尾的上限，超时才硬退
PAPERAGENT_GRACE_SECONDS=30

# ===== 存储 =====
# ⚠️ 路径类键（PAPERAGENT_DB / ENGINE_WORK_ROOT / ENGINE_OUT_ROOT / ENGINE_INPUT_ROOT）
#    默认就指向正确位置（打包版 = exe 同目录；开发 = 项目根）——**不要在这里再写一遍**：
#    同一个事实有两个来源时，实测会让数据写进错误的库（见 docs/DATA-LAYOUT.md §4）。
#    确需覆盖才填，并在 docs/COMPAT-REGISTER.md 登记。
PAPERAGENT_DB=data/paperagent.db
ENGINE_WORK_ROOT=library
ENGINE_OUT_ROOT=data/tmp_export
ENGINE_INPUT_ROOT=input

# ===== 会话 / 缓存 =====
CHAT_HISTORY_LIMIT=12
ANSWER_CACHE_SIZE=256
QUERY_LIMIT_CHARS=1500
