{
  "name": "render_md",
  "description": "从 document.json 重新渲染 Markdown（翻译/总结写回后调用），支持模板切换。",
  "when_to_use": "M5 翻译/总结写回 translation.json 后，或用户更换模板后需要重渲染时。",
  "cost_estimate": "零 token。",
  "input_schema": {
    "type": "object",
    "required": [
      "document_json"
    ],
    "properties": {
      "document_json": {
        "type": "string",
        "description": "output/<DOI>/intermediate/document.json 路径"
      },
      "template": {
        "type": "string",
        "default": "obsidian_bilingual"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "markdown": {
        "type": "string"
      },
      "bytes": {
        "type": "integer"
      }
    }
  },
  "errors": [
    "PAPER-0001",
    "PAPER-0040",
    "PAPER-0501"
  ],
  "example": "render_md(document_json='output/10.1002_adma.202407106/intermediate/document.json')",
  "usage": "dev"
}
